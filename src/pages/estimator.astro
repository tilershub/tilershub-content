---
import Layout from '../layouts/Layout.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import { LABOUR, ADHESIVE_TIERS, EXTRAS, TILE_SIZES, TILE_PRICE_RANGES, WASTE_FACTOR, COVERAGE, tilesNeeded } from '../lib/costData.js'
import { DISTRICT_INFO, districtPath } from '../lib/locations.js'

const year = new Date().getFullYear()

const FAQS = [
  { q: `How much does tiling cost per square foot in Sri Lanka (${year})?`,
    a: `Labour runs Rs. ${LABOUR.min}–${LABOUR.max} per square foot depending on tile size and pattern complexity. Adding adhesive at Rs. ${ADHESIVE_TIERS[0].rate}–${ADHESIVE_TIERS[2].rate}, grout at Rs. ${EXTRAS.grout} and levelling clips at Rs. ${EXTRAS.levelClips}, expect roughly Rs. 160–400 per square foot excluding the tiles themselves. A single tile costs Rs. 90–4,500 or more depending on size and brand.` },
  { q: 'What is the labour rate for tiling in Sri Lanka?',
    a: `Standard floor tiling labour is around Rs. ${LABOUR.default} per square foot. Simple ceramic work outside the cities can be closer to Rs. ${LABOUR.min}. Large-format tiles, diagonal patterns or wall tiling in Colombo can reach Rs. ${LABOUR.max} or more.` },
  { q: 'How many tiles do I need for 100 square feet?',
    a: `Using standard 60×60 cm tiles (3.875 sq.ft each), 100 sq.ft needs ${tilesNeeded(100, 3.875)} tiles including the 12% allowance for cuts and breakages. The same area needs ${tilesNeeded(100, 0.969)} of the smaller 30×30 cm tiles.` },
  { q: 'Why do I need to add 12% wastage to tile quantity?',
    a: 'Tiles get cut at walls, corners and around fittings, and some break during transport and installation. The industry-standard allowance in Sri Lanka is 10–15%; our calculator uses 12%. Complex diagonal patterns may need 15–20%.' },
  { q: 'Which tile adhesive should I use — C1, C2 or C2TE?',
    a: `C1 (Rs. ${ADHESIVE_TIERS[0].rate} per sq.ft) is used for ceramic and porcelain tiles up to 60×60 cm. From 60×60 up to 120×80 cm you need C2 (Rs. ${ADHESIVE_TIERS[1].rate}). Above 120×80 cm, large tiles need a deformable C2TE S1 adhesive (Rs. ${ADHESIVE_TIERS[2].rate}). Using the wrong grade can cause tiles to come loose.` },
  { q: 'Do I need a screed layer before tiling?',
    a: `If the floor slab is uneven or at the wrong level you need a cement-and-sand screed layer (Rs. ${EXTRAS.screed.min}–${EXTRAS.screed.max} per sq.ft). New concrete floors finished to the correct level can be tiled directly with adhesive. Your tiler can confirm after inspecting the floor.` },
  { q: 'How much do tiles cost in Sri Lanka?',
    a: 'Ceramic 30×30 cm tiles start around Rs. 90–250 per tile. Porcelain 60×60 cm runs Rs. 550–1,800 per tile. Large-format 120×120 cm porcelain ranges Rs. 4,500–12,000 per tile depending on brand (Rocell, Lanka Tiles, Megatile and imported brands).' },
  { q: 'How much does it cost to tile a bathroom in Sri Lanka?',
    a: 'A typical 40 sq.ft bathroom floor plus 180 sq.ft of wall tiling costs roughly Rs. 60,000–150,000 in labour and materials (excluding tiles), including waterproofing. With mid-range tiles the total is usually Rs. 120,000–300,000. Post your project free on WedaHub to get exact quotes.' },
]

const faqSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQS.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
})

const howToSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to calculate tiling cost in Sri Lanka',
  description: 'Estimate the total cost of a tiling project including tiles, labour, adhesive, grout and screed.',
  step: [
    { '@type': 'HowToStep', name: 'Measure the area', text: 'Measure the length and width of each room or wall in feet and multiply to get total square feet.' },
    { '@type': 'HowToStep', name: 'Choose a tile size', text: 'Select your tile size — larger tiles need fewer pieces but stronger (more expensive) adhesive.' },
    { '@type': 'HowToStep', name: 'Add 12% wastage', text: 'Multiply the tile count by 1.12 to cover cutting waste and breakage.' },
    { '@type': 'HowToStep', name: 'Apply labour and material rates', text: `Multiply the area by the labour rate (Rs. ${LABOUR.min}–${LABOUR.max} per sq.ft). Then add adhesive, grout, levelling clips and, if needed, screed.` },
    { '@type': 'HowToStep', name: 'Get real quotes', text: 'Post your project free on TilersHub to compare bids from verified tilers in your district.' },
  ],
})

const appSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'TilersHub Tile Calculator Sri Lanka',
  url: 'https://tilershub.lk/estimator',
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Web',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'LKR' },
  description: 'Free tiling cost and tile quantity calculator for Sri Lanka with current labour and material rates.',
})

const topDistricts = DISTRICT_INFO.filter(d => ['colombo','gampaha','kandy','galle','kurunegala','kalutara','matara','puttalam'].includes(d.slug))
---

<Layout
  title={`Tile calculator for Sri Lanka — cost and quantity (${year}) | TilersHub`}
  description={`A free tile calculator for Sri Lanka: tile quantity with 12% wastage, labour (Rs. ${LABOUR.min}–${LABOUR.max} per sq.ft), adhesive, grout and screed costs. ${year} rates.`}
>
  <script slot="head" type="application/ld+json" set:html={faqSchema} />
  <script slot="head" type="application/ld+json" set:html={howToSchema} />
  <script slot="head" type="application/ld+json" set:html={appSchema} />

  <div style="background:var(--navy);padding:36px 20px 40px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:relative;max-width:560px;margin:0 auto;">
      <div style="text-align:left;"><Breadcrumbs items={[{ name: 'Tile Calculator' }]} light /></div>
      <span class="section-label" style="border-color:rgba(255,255,255,0.15);color:rgba(255,255,255,0.5);background:rgba(255,255,255,0.06);">📐 <span class="si-text">COST ESTIMATOR</span><span class="en-text">Cost estimator</span></span>
      <h1 style="font-family: var(--th-display);font-size:clamp(26px,4vw,40px);font-weight:700;color:#fff;margin:12px 0 10px;">
        <span class="si-text">Tiling cost <span style="color:var(--terra);">calculator</span></span>
        <span class="en-text">Tile calculator <span style="color:var(--terra);">Sri Lanka</span></span>
      </h1>
      <p style="font-size:14px;color:rgba(255,255,255,0.5);">
        <span class="si-text">Work out how many tiles you need and what the project will cost</span>
        <span class="en-text">Work out tile quantities, labour and total cost at current rates — {year} Sri Lankan prices</span>
      </p>
    </div>
  </div>

  <!-- Top CTA strip -->
  <div style="background:#FBFAF8;padding:12px 20px;border-bottom:1px solid #E4E0D9;">
    <div style="max-width:580px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;">
      <span style="font-size:13px;color:#6B7076;">Already know your budget? Skip the calculator.</span>
      <a href="https://wedahub.lk/post-project" style="display:inline-flex;align-items:center;gap:6px;background:#C2542B;color:#fff;border-radius:10px;padding:8px 16px;font-size:12px;font-weight:700;text-decoration:none;white-space:nowrap;">
        📋 Post your project free →
      </a>
    </div>
  </div>

  <section style="background:var(--surface);padding:48px 20px 64px;">
    <div style="max-width:580px;margin:0 auto;" id="estimator-app">

      <!-- ── Form Card ── -->
      <div style="background:#fff;border:1px solid var(--border);border-radius:20px;padding:28px 28px 24px;">
        <h2 style="font-size:17px;font-weight:700;color:var(--text);margin-bottom:24px;">Project details</h2>

        <!-- Area in sq.ft -->
        <div class="form-group">
          <label class="form-label">Room / area size <span style="color:var(--terra);">*</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <input type="number" id="area" min="1" step="1" placeholder="e.g. 120" class="form-input" style="flex:1;" />
            <span style="font-size:13px;font-weight:600;color:var(--text-3);white-space:nowrap;background:var(--surface);padding:9px 12px;border:1.5px solid var(--border);border-radius:8px;">sq.ft</span>
          </div>
          <p class="form-hint">Enter the total area to be tiled, in sq.ft</p>
        </div>

        <!-- Tile Size -->
        <div class="form-group">
          <label class="form-label">Tile size</label>
          <select id="tile-size" class="form-select">
            <option value="0.969">30×30 cm &nbsp;·&nbsp; 1×1 ft</option>
            <option value="1.938">60×30 cm &nbsp;·&nbsp; 2×1 ft</option>
            <option value="1.722">40×40 cm &nbsp;·&nbsp; 1.3×1.3 ft</option>
            <option value="3.875" selected>60×60 cm &nbsp;·&nbsp; 2×2 ft</option>
            <option value="4.359">90×45 cm &nbsp;·&nbsp; 3×1.5 ft</option>
            <option value="6.889">80×80 cm &nbsp;·&nbsp; 2.6×2.6 ft</option>
            <option value="7.750">120×60 cm &nbsp;·&nbsp; 4×2 ft</option>
            <option value="10.333">120×80 cm &nbsp;·&nbsp; 4×2.6 ft</option>
            <option value="10.764">100×100 cm &nbsp;·&nbsp; 3.3×3.3 ft</option>
            <option value="12.109">150×75 cm &nbsp;·&nbsp; 5×2.5 ft</option>
            <option value="13.778">160×80 cm &nbsp;·&nbsp; 5.2×2.6 ft</option>
            <option value="23.250">180×120 cm &nbsp;·&nbsp; 6×4 ft</option>
            <option value="31.000">240×120 cm &nbsp;·&nbsp; 8×4 ft</option>
          </select>
          <p class="form-hint" id="adhesive-hint" style="color:var(--navy);font-weight:600;">✓ C1 adhesive applies — up to 60×60 cm</p>
        </div>

        <!-- Tile Price per tile -->
        <div class="form-group">
          <label class="form-label">Tile price <span style="font-size:11px;font-weight:400;color:var(--text-3);">(per tile)</span></label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">Rs.</span>
            <input type="number" id="price-per-tile" min="0" placeholder="e.g. 450" class="form-input" style="flex:1;" />
          </div>
          <p class="form-hint">Price for a single tile — not per box</p>
        </div>

        <!-- Labour Rate -->
        <div class="form-group">
          <label class="form-label">Labour rate</label>
          <div style="display:flex;gap:8px;align-items:center;">
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">Rs.</span>
            <input type="number" id="labour-rate" min="0" value="150" class="form-input" style="flex:1;" />
            <span style="font-size:13px;color:var(--text-3);white-space:nowrap;">/ sq.ft</span>
          </div>
          <p class="form-hint">Typical range: Rs. 100–250 per sq.ft, depending on tile size and pattern</p>
        </div>

        <!-- Additional Costs -->
        <div class="form-group" style="margin-bottom:0;">
          <label class="form-label" style="margin-bottom:10px;">Include additional costs</label>
          <div style="display:flex;flex-direction:column;gap:8px;">

            <!-- Adhesive (auto C1/C2) -->
            <label id="adhesive-toggle" style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-adhesive" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;min-width:0;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);" id="adhesive-label">Adhesive (C1)</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;" id="adhesive-rate-lbl">Rs. 50 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;" id="adhesive-sub">C1 adhesive — tiles up to 60×60 cm</div>
              </div>
            </label>

            <!-- Level Clips -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-clips" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Levelling clip system</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">Rs. 20 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">Tile levelling clips and wedges — for a flat finish</div>
              </div>
            </label>

            <!-- Grout -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-grout" checked style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Grout</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">Rs. 10 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">Grout for all tile joints</div>
              </div>
            </label>

            <!-- Screed -->
            <label style="display:flex;align-items:flex-start;gap:10px;background:var(--surface);border:1.5px solid var(--border);border-radius:12px;padding:12px 14px;cursor:pointer;transition:border-color 0.2s;">
              <input type="checkbox" id="inc-screed" style="margin-top:2px;flex-shrink:0;accent-color:var(--navy);width:15px;height:15px;" />
              <div style="flex:1;">
                <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;">
                  <span style="font-size:13px;font-weight:600;color:var(--text);">Screed (cement and sand)</span>
                  <span style="font-size:12px;font-weight:700;color:var(--navy);white-space:nowrap;">Rs. 100–120 / sq.ft</span>
                </div>
                <div style="font-size:11px;color:var(--text-3);margin-top:2px;">Base screed layer to level the floor before tiling</div>
                <div id="screed-rate-row" style="display:none;margin-top:8px;display:none;">
                  <div style="display:flex;align-items:center;gap:6px;">
                    <span style="font-size:11px;color:var(--text-3);">Rate:</span>
                    <span style="font-size:11px;color:var(--text-3);">Rs.</span>
                    <input type="number" id="screed-rate" value="110" min="100" max="120" step="5"
                      class="form-input" style="width:80px;padding:5px 8px;font-size:12px;"
                      onclick="event.stopPropagation()" />
                    <span style="font-size:11px;color:var(--text-3);">/ sq.ft</span>
                  </div>
                </div>
              </div>
            </label>

          </div>
        </div>

        <button id="calc-btn" class="btn btn-navy btn-full" style="margin-top:20px;font-size:15px;padding:13px;">📐 Calculate cost</button>
      </div>

      <!-- ── Result Card ── -->
      <div id="result" style="display:none;background:var(--navy);border-radius:20px;padding:28px;margin-top:20px;color:#fff;">
        <h3 style="font-size:13px;font-weight:700;color:rgba(255,255,255,0.5);margin-bottom:20px;letter-spacing:1.5px;text-transform:uppercase;">Your estimate</h3>

        <!-- Area + tiles row -->
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px;">
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:14px 16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-area" style="font-size:20px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Area</div>
          </div>
          <div style="background:rgba(255,255,255,0.06);border-radius:12px;padding:14px 16px;border:1px solid rgba(255,255,255,0.08);">
            <div id="res-tiles" style="font-size:20px;font-weight:700;color:var(--terra);">—</div>
            <div style="font-size:10px;color:rgba(255,255,255,0.4);margin-top:2px;">Tiles needed (+12% waste)</div>
          </div>
        </div>

        <!-- Breakdown list -->
        <div style="background:rgba(255,255,255,0.04);border-radius:12px;border:1px solid rgba(255,255,255,0.07);overflow:hidden;margin-bottom:12px;">
          <div id="row-tiles" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:13px;color:rgba(255,255,255,0.6);">🪨 Tile material</span>
            <span id="res-tile-cost" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="font-size:13px;color:rgba(255,255,255,0.6);">👷 Labour</span>
            <span id="res-labour" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-adhesive" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="display:flex;flex-direction:column;">
              <span id="res-adhesive-label" style="font-size:13px;color:rgba(255,255,255,0.6);">🧱 Adhesive (C1)</span>
              <span id="res-adhesive-qty" style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px;"></span>
            </span>
            <span id="res-adhesive" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-clips" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="display:flex;flex-direction:column;">
              <span style="font-size:13px;color:rgba(255,255,255,0.6);">📏 Levelling clips</span>
              <span id="res-clips-qty" style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px;"></span>
            </span>
            <span id="res-clips" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-grout" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;border-bottom:1px solid rgba(255,255,255,0.06);">
            <span style="display:flex;flex-direction:column;">
              <span style="font-size:13px;color:rgba(255,255,255,0.6);">🪣 Grout</span>
              <span id="res-grout-qty" style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px;"></span>
            </span>
            <span id="res-grout" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
          <div id="row-screed" style="display:flex;justify-content:space-between;align-items:center;padding:11px 16px;">
            <span style="display:flex;flex-direction:column;">
              <span style="font-size:13px;color:rgba(255,255,255,0.6);">🏗️ Screed layer</span>
              <span id="res-screed-qty" style="font-size:10px;color:rgba(255,255,255,0.35);margin-top:2px;"></span>
            </span>
            <span id="res-screed" style="font-size:13px;font-weight:700;color:#fff;">—</span>
          </div>
        </div>

        <!-- Grand Total -->
        <div style="background:rgba(194,84,43,0.15);border:1px solid rgba(194,84,43,0.3);border-radius:12px;padding:18px;text-align:center;">
          <div style="font-size:11px;color:rgba(255,255,255,0.45);margin-bottom:4px;letter-spacing:1px;text-transform:uppercase;">ESTIMATED TOTAL</div>
          <div id="res-total" style="font-size:30px;font-weight:700;color:var(--terra);">—</div>
          <div id="res-total-note" style="font-size:10px;color:rgba(255,255,255,0.3);margin-top:4px;">Includes all selected items</div>
        </div>

        <p style="font-size:11px;color:rgba(255,255,255,0.28);text-align:center;margin-top:14px;line-height:1.7;">
          This is an estimate only. Actual costs vary with tile brand, pattern complexity and site conditions.
        </p>

        <!-- Post project CTA -->
        <div style="margin-top:18px;background:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12);border-radius:14px;padding:18px 20px;">
          <div style="font-size:13px;font-weight:700;color:#fff;margin-bottom:4px;">📋 Ready to get started?</div>
          <p style="font-size:12px;color:rgba(255,255,255,0.55);margin:0 0 14px;line-height:1.7;">
            Post your project free — tilers in your area will send quotes.
          </p>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">
            <a href="https://wedahub.lk/post-project" style="display:inline-flex;align-items:center;gap:7px;background:var(--terra);color:#fff;border-radius:10px;padding:10px 20px;font-size:13px;font-weight:700;text-decoration:none;flex:1;justify-content:center;">
              Post your project →
            </a>
            <button id="share-estimate-btn" style="display:inline-flex;align-items:center;gap:7px;background:rgba(255,255,255,0.1);color:rgba(255,255,255,0.8);border:1px solid rgba(255,255,255,0.2);border-radius:10px;padding:10px 20px;font-size:13px;font-weight:700;cursor:pointer;flex:1;justify-content:center;">
              🔗 Share this estimate
            </button>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ SEO CONTENT: methodology, rate tables, worked example, FAQ ═══ -->
  <section style="background:#FBFAF8;border-top:1px solid #E4E0D9;padding:44px 20px 64px;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:28px;">

      <!-- Methodology -->
      <div>
        <h2 style="font-family: var(--th-display);font-size:clamp(18px,4vw,24px);font-weight:700;color:#14171A;margin:0 0 12px;">How to work out tiling costs in Sri Lanka ({year})</h2>
        <p style="font-size:14px;color:#3A4046;line-height:1.9;margin:0 0 10px;">
          A tiling project has five cost components: <strong>Tile material</strong>, <strong>labour</strong>, <strong>Adhesive</strong>, <strong>grout and levelling clips</strong>and, if the floor is uneven, <strong>a cement-and-sand screed layer</strong>. Current labour rates in Sri Lanka are <strong>Rs. {LABOUR.min}–{LABOUR.max} per sq.ft</strong> (Rs. {LABOUR.default} is typical for standard floor tiling). Tile quantities should always include <strong>a 12% wastage allowance</strong> for cuts and breakages.
        </p>
        <p style="font-size:14px;color:#3A4046;line-height:1.9;margin:0;">
          The calculator above uses these market rates. For more detail, read:
          <a href="/guides/tiling-cost-guide-sri-lanka" style="color:#C2542B;font-weight:700;">the tiling cost guide</a> or <a href="https://wedahub.lk/post-project" style="color:#C2542B;font-weight:700;">post your project free</a> to get real quotes from verified tradespeople.
        </p>
      </div>

      <!-- Labour + adhesive tables -->
      <div style="background:#fff;border:1px solid #E4E0D9;border-radius:16px;padding:20px;overflow-x:auto;">
        <h2 style="font-size:16px;font-weight:800;color:#14171A;margin:0 0 12px;">Tiling labour and material rates in Sri Lanka</h2>
        <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:420px;">
          <thead>
            <tr>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Item</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Rate (Rs. / sq.ft)</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Tiling labour</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;">{LABOUR.min} – {LABOUR.max}</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Varies with tile size, pattern and location</td></tr>
            {ADHESIVE_TIERS.map(t => (
              <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Adhesive {t.name}</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;">{t.rate}</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">{t.sizes} — {t.desc}</td></tr>
            ))}
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Levelling clips</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;">{EXTRAS.levelClips}</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Levelling aids for a finish with no lippage</td></tr>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Grout</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;">{EXTRAS.grout}</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">All tile joints</td></tr>
            <tr><td style="padding:9px 12px;">Screed (if needed)</td><td style="padding:9px 12px;font-weight:700;">{EXTRAS.screed.min} – {EXTRAS.screed.max}</td><td style="padding:9px 12px;">Cement-and-sand base that levels the floor</td></tr>
          </tbody>
        </table>
      </div>

      <!-- Tiles per 100 sqft table -->
      <div style="background:#fff;border:1px solid #E4E0D9;border-radius:16px;padding:20px;overflow-x:auto;">
        <h2 style="font-size:16px;font-weight:800;color:#14171A;margin:0 0 12px;">How many tiles for 100 sq.ft? (including 12% wastage)</h2>
        <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:320px;">
          <thead>
            <tr>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Tile size</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Coverage per tile</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Tiles per 100 sq.ft</th>
            </tr>
          </thead>
          <tbody>
            {TILE_SIZES.slice(0, 9).map(t => (
              <tr>
                <td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">{t.label}</td>
                <td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">{t.sqft.toFixed(2)} sq.ft</td>
                <td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">{tilesNeeded(100, t.sqft)} tiles</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p style="font-size:12px;color:#6B7076;margin:10px 0 0;line-height:1.7;">
          Typical tile prices: {TILE_PRICE_RANGES.map((r, i) => `${r.size} ${r.range}${i < TILE_PRICE_RANGES.length - 1 ? ' · ' : ''}`)} — See the full breakdown: <a href="/guides/tile-prices-sri-lanka" style="color:#C2542B;font-weight:700;">the tile price list</a> and
          <a href="/guides/tiling-labour-charges-sri-lanka" style="color:#C2542B;font-weight:700;">the labour rate guide</a>.
        </p>
      </div>

      <!-- Material quantities per 100 sqft -->
      <div style="background:#fff;border:1px solid #E4E0D9;border-radius:16px;padding:20px;overflow-x:auto;">
        <h2 style="font-size:16px;font-weight:800;color:#14171A;margin:0 0 12px;">Material quantities for 100 sq.ft</h2>
        <table style="width:100%;border-collapse:collapse;font-size:13px;min-width:380px;">
          <thead>
            <tr>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Material</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Quantity per 100 sq.ft</th>
              <th style="background:#C2542B;color:#fff;padding:9px 12px;text-align:left;font-size:12px;">Basis</th>
            </tr>
          </thead>
          <tbody>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">C1 / C2 Adhesive (25 kg bag)</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">3 bags</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">1 bag ≈ 30–35 sq.ft</td></tr>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">C2TE Adhesive (25 kg bag)</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">3–4 bags</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Large tiles need a thicker bed</td></tr>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">Grout</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">2–4 kg</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Varies with tile size and joint width</td></tr>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">Levelling clips</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">Varies with tile size</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">Roughly 3–8 per tile; wedges are reusable</td></tr>
            <tr><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:600;">Screed cement (50 kg bag)</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;font-weight:700;color:#C2542B;">2–3 bags</td><td style="padding:9px 12px;border-bottom:1px solid #E4E0D9;">2 bags for standard screed · 3 bags for premium</td></tr>
            <tr><td style="padding:9px 12px;font-weight:600;">Screed sand</td><td style="padding:9px 12px;font-weight:700;color:#C2542B;">20 cu.ft</td><td style="padding:9px 12px;">River sand or manufactured sand</td></tr>
          </tbody>
        </table>
        <p style="font-size:12px;color:#6B7076;margin:10px 0 0;line-height:1.7;">
          The calculator above shows the adhesive bags, kilograms of grout, clip count and screed cement/sand your area needs.
        </p>
      </div>

      <!-- Worked example -->
      <div style="background:#F7EFE9;border:1px solid #E7D9CE;border-radius:16px;padding:20px;">
        <h2 style="font-size:16px;font-weight:800;color:#C2542B;margin:0 0 12px;">Example: a 100 sq.ft floor in 60×60 cm tiles</h2>
        <div style="font-size:13px;color:#2A2F35;line-height:2;">
          <div>• Tiles needed: 100 ÷ 3.875 × 1.12 = <strong>{tilesNeeded(100, 3.875)} tiles</strong> (at Rs. 900 per tile → Rs. {(tilesNeeded(100, 3.875) * 900).toLocaleString('en-LK')})</div>
          <div>• Labour: sq.ft 100 × Rs. {LABOUR.default} = <strong>Rs. {(100 * LABOUR.default).toLocaleString('en-LK')}</strong></div>
          <div>• C1 adhesive: 100 × Rs. {ADHESIVE_TIERS[0].rate} = <strong>Rs. {(100 * ADHESIVE_TIERS[0].rate).toLocaleString('en-LK')}</strong></div>
          <div>• Levelling clips: 100 × Rs. {EXTRAS.levelClips} = <strong>Rs. {(100 * EXTRAS.levelClips).toLocaleString('en-LK')}</strong> · Grout: 100 × Rs. {EXTRAS.grout} = <strong>Rs. {(100 * EXTRAS.grout).toLocaleString('en-LK')}</strong></div>
          <div style="border-top:1px solid #E7D9CE;margin-top:6px;padding-top:6px;">≈ <strong>Rs. {(tilesNeeded(100, 3.875) * 900 + 100 * (LABOUR.default + ADHESIVE_TIERS[0].rate + EXTRAS.levelClips + EXTRAS.grout)).toLocaleString('en-LK')} total</strong> (no screed needed)</div>
        </div>
      </div>

      <!-- FAQ -->
      <div>
        <h2 style="font-family: var(--th-display);font-size:clamp(18px,4vw,24px);font-weight:700;color:#14171A;margin:0 0 14px;">Tiling cost FAQs</h2>
        <div style="display:flex;flex-direction:column;gap:10px;">
          {FAQS.map(f => (
            <details style="background:#fff;border:1px solid #E4E0D9;border-radius:12px;padding:14px 16px;">
              <summary style="font-size:13px;font-weight:700;color:#14171A;cursor:pointer;">{f.q}</summary>
              <p style="font-size:13px;color:#3A4046;line-height:1.8;margin:10px 0 0;">{f.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Find tilers by district -->
      <div>
        <h2 style="font-size:16px;font-weight:800;color:#14171A;margin:0 0 10px;">Ready to hire? Find tilers near you</h2>
        <div style="display:flex;flex-wrap:wrap;gap:8px;">
          {topDistricts.map(d => (
            <a href={districtPath(d)} style="font-size:12px;font-weight:700;color:#C2542B;background:#fff;border:1px solid #E7D9CE;border-radius:20px;padding:7px 14px;text-decoration:none;">Tilers — {d.name}</a>
          ))}
          <a href="https://wedahub.lk/providers?type=tiler" style="font-size:12px;font-weight:700;color:#fff;background:#C2542B;border-radius:20px;padding:7px 14px;text-decoration:none;">All districts →</a>
        </div>
      </div>

    </div>
  </section>

  <script>
    const tileSizeEl   = document.getElementById('tile-size')
    const adhLabelEl   = document.getElementById('adhesive-label')
    const adhRateLblEl = document.getElementById('adhesive-rate-lbl')
    const adhSubEl     = document.getElementById('adhesive-sub')
    const adhHintEl    = document.getElementById('adhesive-hint')
    const adhResLabel  = document.getElementById('res-adhesive-label')
    const screedCb     = document.getElementById('inc-screed')
    const screedRow    = document.getElementById('screed-rate-row')

    // Returns 'c1' | 'c2' | 'c2te'
    function adhesiveTier() {
      const v = parseFloat(tileSizeEl.value)
      if (v <= 3.875)  return 'c1'   // up to 60×60 cm
      if (v <= 10.333) return 'c2'   // up to 120×80 cm
      return 'c2te'                   // above 120×80 cm
    }

    const ADHESIVE = {
      c1:   { label: 'Adhesive (C1)',       rate: 50,  bagSqft: 35, rateLabel: 'Rs. 50 / sq.ft',  sub: 'C1 adhesive — tiles up to 60×60 cm',              hint: '✓ C1 adhesive applies — up to 60×60 cm' },
      c2:   { label: 'Adhesive (C2)',       rate: 80,  bagSqft: 35, rateLabel: 'Rs. 80 / sq.ft',  sub: 'C2 adhesive — tiles 90×45 cm to 120×80 cm', hint: '✓ C2 adhesive applies — 90×45 cm to 120×80 cm' },
      c2te: { label: 'Adhesive (C2TE S1)', rate: 120, bagSqft: 30, rateLabel: 'Rs. 120 / sq.ft', sub: 'C2TE S1 adhesive — large tiles above 120×80 cm', hint: '✓ C2TE S1 adhesive applies — large tiles above 120×80 cm' },
    }

    // Levelling clips per tile depend on tile size (wedges reusable)
    function clipsPerTile(tileSqft) {
      if (tileSqft <= 2) return 3
      if (tileSqft <= 4) return 4
      if (tileSqft <= 11) return 6
      return 8
    }

    function updateAdhesive() {
      const tier = ADHESIVE[adhesiveTier()]
      adhLabelEl.textContent   = tier.label
      adhRateLblEl.textContent = tier.rateLabel
      adhSubEl.textContent     = tier.sub
      adhHintEl.textContent    = tier.hint
      if (adhResLabel) adhResLabel.textContent = '🧱 ' + tier.label
    }

    tileSizeEl.addEventListener('change', updateAdhesive)
    updateAdhesive()

    screedCb.addEventListener('change', function () {
      screedRow.style.display = this.checked ? 'block' : 'none'
    })

    document.getElementById('calc-btn').addEventListener('click', () => {
      const area         = parseFloat(document.getElementById('area').value)
      const tileSqft     = parseFloat(tileSizeEl.value)
      const pricePerTile = parseFloat(document.getElementById('price-per-tile').value) || 0
      const labourRate   = parseFloat(document.getElementById('labour-rate').value) || 150
      const incAdhesive  = document.getElementById('inc-adhesive').checked
      const incClips     = document.getElementById('inc-clips').checked
      const incGrout     = document.getElementById('inc-grout').checked
      const incScreed    = screedCb.checked
      const screedRate   = parseFloat(document.getElementById('screed-rate').value) || 110

      if (!area || area <= 0) { alert('Please enter the area in sq.ft.'); return }

      const tilesNeeded   = Math.ceil((area / tileSqft) * 1.12)
      const tileCost      = pricePerTile > 0 ? tilesNeeded * pricePerTile : null
      const labourCost    = area * labourRate
      const tier          = ADHESIVE[adhesiveTier()]
      const adhesiveCost  = incAdhesive ? area * tier.rate : 0
      const clipsCost     = incClips    ? area * 20 : 0
      const groutCost     = incGrout    ? area * 10 : 0
      const screedCost    = incScreed   ? area * screedRate : 0

      // Material quantities
      const adhesiveBags    = Math.ceil(area / tier.bagSqft)        // 25kg bags (~3 per 100 sq.ft; 3–4 large format)
      const groutKg         = Math.ceil(area / 35)                  // 2–4 kg per 100 sq.ft
      const clipsCount      = tilesNeeded * clipsPerTile(tileSqft)  // depends on tile size
      const isPremiumScreed = screedRate >= 115                     // premium screed uses more cement
      const cementBags      = Math.ceil(area * (isPremiumScreed ? 0.03 : 0.02)) // 2–3 bags per 100 sq.ft
      const sandCuft        = Math.ceil(area * 0.20)                // 20 cu.ft per 100 sq.ft

      const extrasCost    = labourCost + adhesiveCost + clipsCost + groutCost + screedCost
      const total         = (tileCost || 0) + extrasCost

      const fmt = n => 'Rs. ' + Math.round(n).toLocaleString('en-LK')

      document.getElementById('res-area').textContent      = area.toLocaleString('en-LK') + ' sq.ft'
      document.getElementById('res-tiles').textContent     = tilesNeeded + ' tiles'
      document.getElementById('res-tile-cost').textContent = tileCost ? fmt(tileCost) : '— (enter a tile price)'
      document.getElementById('res-labour').textContent    = fmt(labourCost)

      document.getElementById('row-adhesive').style.display = incAdhesive ? 'flex' : 'none'
      document.getElementById('res-adhesive').textContent   = fmt(adhesiveCost)
      document.getElementById('res-adhesive-qty').textContent = incAdhesive ? `25 kg bags × ${adhesiveBags}` : ''

      document.getElementById('row-clips').style.display = incClips ? 'flex' : 'none'
      document.getElementById('res-clips').textContent   = fmt(clipsCost)
      document.getElementById('res-clips-qty').textContent = incClips ? `clips × ${clipsCount.toLocaleString('en-LK')} (+ wedges)` : ''

      document.getElementById('row-grout').style.display = incGrout ? 'flex' : 'none'
      document.getElementById('res-grout').textContent   = fmt(groutCost)
      document.getElementById('res-grout-qty').textContent = incGrout ? `~${groutKg} kg` : ''

      document.getElementById('row-screed').style.display = incScreed ? 'flex' : 'none'
      document.getElementById('res-screed').textContent   = fmt(screedCost)
      document.getElementById('res-screed-qty').textContent = incScreed ? `${isPremiumScreed ? 'Premium' : 'Standard'} · cement 50 kg × ${cementBags} · sand ${sandCuft} cu.ft` : ''

      document.getElementById('res-total').textContent     = tileCost ? fmt(total) : fmt(extrasCost)
      document.getElementById('res-total-note').textContent = tileCost
        ? 'Tiles + labour + selected extras'
        : 'Labour + extras (no tile price)'

      document.getElementById('result').style.display = 'block'
      document.getElementById('result').scrollIntoView({ behavior: 'smooth', block: 'nearest' })
    })

    document.getElementById('share-estimate-btn').addEventListener('click', async function () {
      const url = window.location.href
      const title = 'Tiling cost estimate — TilersHub'
      if (navigator.share) {
        try { await navigator.share({ title, url }) } catch (_) {}
      } else {
        await navigator.clipboard.writeText(url)
        this.textContent = '✓ Copied!'
        setTimeout(() => { this.textContent = '🔗 Share this estimate' }, 2000)
      }
    })
  </script>

</Layout>
