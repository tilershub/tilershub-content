---
import Layout from '../layouts/Layout.astro'
import { GUIDES } from '../data/guides.js'
import { BLOG_POSTS } from '../lib/blog-posts.js'
---
<Layout title="Tiling Guides & Cost Calculator Sri Lanka | TilersHub" description="In-depth articles, guides and a free tiling cost estimator for tiling work in Sri Lanka.">
  <section class="resource-intro">
    <p class="eyebrow">TILERSHUB · SRI LANKA</p>
    <h1>Tiling guides, costs &amp;<br />tile calculator for Sri Lanka.</h1>
    <p>Plan floor and bathroom tiling with practical guides to tile selection, installation and waterproofing. Calculate tile quantities and compare labour and material costs before asking for quotes.</p>
    <div class="resource-actions"><a class="resource-button" href="/estimator">Estimate your cost</a><a href="/guides">Browse guides →</a></div>
  </section>
  <section class="resource-section" aria-labelledby="planning-guides">
    <h2 id="planning-guides">Plan your tiling project</h2>
    <div class="resource-grid">
      <a class="resource-card" href="/estimator"><span aria-hidden="true">📐</span><h3>Tile quantity &amp; cost calculator</h3><p>Enter your area, tile size and prices to estimate tiles, wastage, labour and materials.</p><small>Calculate your estimate →</small></a>
      {GUIDES.filter(g => ['tiling-cost-guide-sri-lanka', 'tile-prices-sri-lanka', 'tiling-labour-charges-sri-lanka', 'how-to-choose-tile-size', 'understanding-tile-grades'].includes(g.slug)).map(guide => <a class="resource-card" href={`/guides/${guide.slug}/`}><span aria-hidden="true">{guide.icon}</span><h3>{guide.title}</h3><p>{guide.excerpt}</p><small>Read guide →</small></a>)}
    </div>
  </section>
  <section class="resource-section">
    <h2>Articles &amp; Advice</h2>
    <div class="resource-grid">{BLOG_POSTS.map(post => <a class="resource-card" href={`/blog/${post.slug}/`}><span aria-hidden="true">{post.icon}</span><h3>{post.title}</h3><p>{post.excerpt}</p><small>{post.readTime} →</small></a>)}</div>
  </section>
  <aside class="marketplace-banner"><h2>Looking for the right person for the job?</h2><p>TilersHub is your tiling knowledge and planning resource. Hiring and project posting are now on WedaHub, our skilled-services platform.</p><a class="resource-button" href="https://wedahub.lk">Go to WedaHub →</a></aside>
</Layout>
