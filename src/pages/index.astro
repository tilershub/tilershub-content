---
import Layout from '../layouts/Layout.astro'
import { BLOG_POSTS } from '../lib/blog-posts.js'
---
<Layout title="TilersHub · Tiling Guides and Cost Estimator" description="In-depth articles, guides and a free tiling cost estimator for tiling work in Sri Lanka.">
  <section class="resource-intro">
    <p class="eyebrow">TILERSHUB · SRI LANKA</p>
    <h1>Knowledge and planning<br />for your tiling work.</h1>
    <p>From choosing a tile to working out the cost — the articles and tools you need to plan your project.</p>
    <div class="resource-actions"><a class="resource-button" href="/estimator">Estimate your cost</a><a href="/guides">Browse guides →</a></div>
  </section>
  <section class="resource-section">
    <h2>Articles &amp; Advice</h2>
    <div class="resource-grid">{BLOG_POSTS.map(post => <a class="resource-card" href={`/blog/${post.slug}`}><span aria-hidden="true">{post.icon}</span><h3>{post.title}</h3><p>{post.excerpt}</p><small>{post.readTime} →</small></a>)}</div>
  </section>
  <aside class="marketplace-banner"><h2>Looking for the right person for the job?</h2><p>Find service providers. Post your project and get quotes.</p><a class="resource-button" href="https://wedahub.lk">Go to WedaHub →</a></aside>
</Layout>
