---
import Layout from '../layouts/Layout.astro'
// Read the real article list rather than keeping a second copy here: the
// duplicate had already drifted (it showed a 4-minute read time for a post
// blog-posts.js calls 5 min).
import { BLOG_POSTS as posts } from '../lib/blog-posts.js'
---

<Layout
  title="Articles & Advice · TilersHub"
  description="Tiling guides, cost breakdowns, and advice on choosing a tiler and improving your home, for Sri Lankan homeowners."
>
  <!-- Header -->
  <div style="background:linear-gradient(135deg,#14171A 0%,#14171A 100%);padding:32px 20px 28px;text-align:center;position:relative;overflow:hidden;">
    <div style="position:absolute;inset:0;opacity:0.03;background-image:repeating-linear-gradient(0deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px),repeating-linear-gradient(90deg,transparent,transparent 39px,rgba(255,255,255,0.8) 39px,rgba(255,255,255,0.8) 40px);pointer-events:none;"></div>
    <div style="position:relative;">
      <span style="font-size:9px;font-weight:700;color:rgba(194,84,43,0.7);letter-spacing:3px;text-transform:uppercase;display:block;margin-bottom:10px;">Resources</span>
      <h1 style="font-family: var(--th-display);font-size:clamp(22px,4vw,32px);font-weight:700;color:#fff;margin:0 0 8px;">Articles &amp; Advice</h1>
      <p style="font-size:13px;color:rgba(255,255,255,0.5);margin:0;max-width:400px;margin:0 auto;">Tiling guides, costs and hiring advice for Sri Lankan homeowners.</p>
    </div>
  </div>

  <!-- Post grid -->
  <div style="background:#FBFAF8;min-height:400px;padding:24px 16px 80px;overflow-x:hidden;">
    <div style="max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:12px;">
      {posts.slice(0,2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #E4E0D9;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#D6D0C6'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#E4E0D9'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#C2542B;background:#F7EFE9;border:1px solid #E7D9CE;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#8A8F95;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#14171A;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#6B7076;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#D6D0C6;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Post project CTA card -->
      <a href="https://wedahub.lk/post-project"
        style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;background:#C2542B;border-radius:14px;padding:16px 18px;text-decoration:none;box-shadow:0 4px 18px rgba(194,84,43,0.25);">
        <div style="font-size:28px;flex-shrink:0;">🏠</div>
        <div style="flex:1;min-width:160px;">
          <div style="font-size:13px;font-weight:800;color:#fff;margin-bottom:3px;">Ready to start your project?</div>
          <div style="font-size:11px;color:rgba(255,255,255,0.78);line-height:1.5;">Post for free and get quotes from verified professionals over WhatsApp.</div>
        </div>
        <div style="background:rgba(255,255,255,0.18);color:#fff;border-radius:10px;padding:9px 16px;font-size:12px;font-weight:800;white-space:nowrap;flex-shrink:0;">
          Post for free →
        </div>
      </a>

      {posts.slice(2).map(post => (
        <a href={`/blog/${post.slug}`}
          style="display:flex;align-items:center;gap:0;background:#fff;border-radius:14px;overflow:hidden;border:1px solid #E4E0D9;text-decoration:none;color:inherit;box-shadow:0 1px 4px rgba(0,0,0,0.04);transition:box-shadow 0.15s,border-color 0.15s;"
          onmouseover="this.style.boxShadow='0 4px 16px rgba(0,0,0,0.09)';this.style.borderColor='#D6D0C6'"
          onmouseout="this.style.boxShadow='0 1px 4px rgba(0,0,0,0.04)';this.style.borderColor='#E4E0D9'"
        >
          <div style={`width:82px;height:88px;background:${post.color};flex-shrink:0;display:flex;align-items:center;justify-content:center;font-size:30px;`}>
            {post.icon}
          </div>
          <div style="flex:1;padding:14px 16px;min-width:0;">
            <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px;">
              <span style="font-size:9px;font-weight:700;color:#C2542B;background:#F7EFE9;border:1px solid #E7D9CE;border-radius:20px;padding:1px 7px;">{post.category}</span>
              <span style="font-size:10px;color:#8A8F95;">{post.readTime}</span>
            </div>
            <div style="font-size:13px;font-weight:700;color:#14171A;line-height:1.35;margin-bottom:4px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;">{post.title}</div>
            <div style="font-size:11px;color:#6B7076;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;">{post.excerpt}</div>
          </div>
          <div style="padding:0 14px;font-size:20px;color:#D6D0C6;flex-shrink:0;">›</div>
        </a>
      ))}

      <!-- Coming soon card -->
      <div style="text-align:center;padding:28px 20px;background:#fff;border-radius:14px;border:1.5px dashed #E4E0D9;margin-top:4px;">
        <div style="font-size:32px;margin-bottom:10px;">✍️</div>
        <div style="font-size:13px;font-weight:700;color:#3A4046;margin-bottom:4px;">More articles coming soon</div>
        <div style="font-size:12px;color:#8A8F95;">Flooring, waterproofing, cost estimating and more.</div>
      </div>
    </div>
  </div>

</Layout>
